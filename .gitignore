# ------------------------------
# Laravel (backend) ignores
# ------------------------------
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/storage/*.key
/backend/storage/framework/cache/
/backend/storage/framework/sessions/
/backend/storage/framework/testing/
/backend/storage/framework/views/
/backend/storage/logs/
/backend/public/storage/
/backend/.phpunit.result.cache
/backend/.idea/
/backend/.vscode/
/backend/*.sqlite
/backend/*.sqlite-journal
/backend/Homestead.json
/backend/Homestead.yaml
/backend/.vagrant/
/backend/.fleet/
/backend/.php-cs-fixer.cache
/backend/.phpunit.cache/

# ------------------------------
# React (frontend) ignores
# ------------------------------
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/build/
/frontend/.vite/
/frontend/.cache/
/frontend/coverage/
/frontend/.eslintcache
/frontend/*.log
/frontend/.DS_Store

# ------------------------------
# General / OS / IDE
# ------------------------------
.DS_Store
Thumbs.db
*.log
*.tmp
.env.backup
*.swp
.swo
.idea/
.vscode/
.vscode/settings.json
*.sublime-*
/.phpunit.result.cache
/.phpunit.cache
/.fleet/
/.zed/
/composer.lock
/package-lock.json
/yarn.lock
/.php-version
/.tool-versions

# ------------------------------
# Testing & coverage
# ------------------------------
/backend/coverage/
/backend/.coverage
/backend/.phpunit.cache/
/frontend/coverage/
/frontend/.nyc_output/

# ------------------------------
# Docker / Laravel Sail
# ------------------------------
/backend/.docker/
/backend/docker-compose.override.yml
/backend/.sail/

# ------------------------------
# Laravel specific – compiled assets
# ------------------------------
/backend/public/css/
/backend/public/js/
/backend/public/mix-manifest.json
/backend/public/hot
/backend/storage/debugbar/

# ------------------------------
# Environment files (keep .example)
# ------------------------------
*.env
!.env.example