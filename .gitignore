# Sabay Shop Consolidated .gitignore

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# IDE & Editor Files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.zed/
.fleet/

# -----------------------------------------------------------------------------
# Environment & Secrets (SECURITY CRITICAL)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
auth.json
*.key

# -----------------------------------------------------------------------------
# Backend (Laravel) Specific
# -----------------------------------------------------------------------------
/backend/vendor/
/backend/node_modules/
/backend/public/storage/
/backend/public/hot/
/backend/public/build/
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/storage/debugbar/
/backend/storage/pail/
/backend/phpunit.xml
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/backend/.php-cs-fixer.cache
/backend/Homestead.json
/backend/Homestead.yaml
/backend/.vagrant/
/backend/*.sqlite
/backend/*.sqlite-journal

# -----------------------------------------------------------------------------
# Frontend (React/Vite) Specific
# -----------------------------------------------------------------------------
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/build/
/frontend/.vite/
/frontend/.cache/
/frontend/coverage/
/frontend/.nyc_output/
/frontend/.eslintcache
/frontend/*.log
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
*.log
/node_modules/
/vendor/
